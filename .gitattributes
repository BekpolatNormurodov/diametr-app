* text=auto

# Files that are consumed by Linux containers MUST keep LF endings.
# A CRLF nginx.conf or entrypoint script fails in confusing ways — this bit us
# once already when a config was uploaded from Windows.
*.sh            text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile*     text eol=lf
.env.example    text eol=lf
*.prisma        text eol=lf

# Source
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.dart          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.css           text eol=lf
*.html          text eol=lf

# Windows-only tooling keeps CRLF
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Binary — never touch
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.ico           binary
*.gif           binary
*.svg           text eol=lf
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.jks           binary
*.keystore      binary
*.jar           binary
*.so            binary
*.aab           binary
*.apk           binary
