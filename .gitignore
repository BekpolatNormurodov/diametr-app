# ── Secrets ──────────────────────────────────────────────────────────────────
# NEVER commit these. The Android signing keystore in particular: lose control
# of it and you lose the ability to ship updates to the published Play Store app.
.env
.env.*
!.env.example
*.jks
*.keystore
key.properties
google-services.json
GoogleService-Info.plist
*.p8
*.p12
*.mobileprovision
*.pem
!infra/**/*.example.pem

# Database dumps — they carry real user phone numbers and admin credentials.
*.sql
!apps/backend/prisma/migrations/**/*.sql

# ── Runtime data (lives on the server, not in git) ───────────────────────────
logs/
mysql_data/
certbot/conf/
certbot/www/
infra/nginx/cache/
infra/nginx/cache-static/

# Uploaded images: ~2.3 GB in production. Directory shape is kept via .gitkeep.
apps/backend/public/*/*
!apps/backend/public/*/.gitkeep

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# ── Flutter / Dart ───────────────────────────────────────────────────────────
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
apps/diametr_mobile/build/
apps/diametr_mobile/android/.gradle/
apps/diametr_mobile/android/local.properties
apps/diametr_mobile/android/app/debug/
apps/diametr_mobile/android/app/profile/
apps/diametr_mobile/android/app/release/
apps/diametr_mobile/ios/Pods/
apps/diametr_mobile/ios/.symlinks/
apps/diametr_mobile/ios/Flutter/Flutter.framework
apps/diametr_mobile/ios/Flutter/Generated.xcconfig
apps/diametr_mobile/ios/Flutter/flutter_export_environment.sh
*.iml

# ── Editors / OS ─────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db
*.swp
