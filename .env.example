# ─── MySQL ────────────────────────────────────────────────────────────────────
# Root password used only by MySQL init
DB_ROOT_PASSWORD=change_me_root

# Application database credentials (must match what is in diametr_backend .env)
DB_USER=diametr_user
DB_PASSWORD=change_me_password
DB_NAME=diametr_db

# Local host path where MySQL stores its data files.
# Point this to your existing MySQL datadir if you want to reuse local data,
# or leave it as ./mysql_data for a fresh Docker-managed folder.
MYSQL_DATA_PATH=./mysql_data

# ─── Backend ──────────────────────────────────────────────────────────────────
# Automatically assembled in docker-compose.yml from DB_* vars above:
# DATABASE_URL=mysql://diametr_user:change_me_password@mysql:3306/diametr_db

JWT_SECRET=change_me_jwt_secret_min_32_chars

# Backend HTTP port (internal only — nginx proxies to this)
PORT=8888

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=Asia/Tashkent
