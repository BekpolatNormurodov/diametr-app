# ─── MySQL ────────────────────────────────────────────────────────────────────
# Root password used only by MySQL init
DB_ROOT_PASSWORD=change_me_root

# Application database credentials (must match what is in diametr_backend .env)
DB_USER=diametr_user
DB_PASSWORD=change_me_password
DB_NAME=diametr_db

# Local host path where MySQL stores its data files.
# Point this to your existing MySQL datadir if you want to reuse local data,
# or leave it as ./mysql_data for a fresh Docker-managed folder.
MYSQL_DATA_PATH=./mysql_data

# ─── Backend ──────────────────────────────────────────────────────────────────
# Automatically assembled in docker-compose.yml from DB_* vars above:
# DATABASE_URL=mysql://diametr_user:change_me_password@mysql:3306/diametr_db

JWT_SECRET=change_me_jwt_secret_min_32_chars

# Backend HTTP port (internal only — nginx proxies to this)
PORT=8888

JWT_EXPIRES=7d

# ─── Telegram bots ────────────────────────────────────────────────────────────
# From BotFather. NEVER hardcode these in a Dockerfile — an ENV instruction is
# baked into the image layers and readable by anyone who can pull the image.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to receive notifications and issue commands
TELEGRAM_CHAT_IDS=
BACKEND_URL=https://api.diametr.uz

# Store bot (order notifications for shop owners)
STORE_BOT_TOKEN=
STORE_BOT_WEBHOOK_URL=https://api.diametr.uz

# ─── Eskiz.uz SMS gateway ─────────────────────────────────────────────────────
ESKIZ_ENABLED=true
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_CALLBACK_URL=

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=Asia/Tashkent
