model Shop {
    id    Int     @id @default(autoincrement())
    // Bilingual shop identity. name kept for legacy rows; name_uz/name_ru
    // preferred going forward. Address in Text form so a longer street +
    // landmark description fits.
    name  String?
    name_uz String?
    name_ru String?
    image String?

    work_status     WORK_STATUS @default(WORKING)
    address         String? @db.Text
    address_ru      String? @db.Text
    inn         String?
    lat             Float?
    lon            Float?
    delivery_amount Int?
    yandex_delivery Boolean @default(true)
    market_delivery Boolean @default(true)
    fixed_delivery Boolean @default(true)
    expired DateTime?
    balance Int @default(0)
    auto_payment Boolean @default(true)

    region_id Int?
    region    Region? @relation(fields: [region_id], references: [id])


    admins Admin[]
    ads Ad[]

    products ShopProduct[]

    orders Order[]

    payments Payment[]

    promo_codes PromoCode[]

    balance_logs ShopBalanceLog[]

    createdt  DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("shop")
}
