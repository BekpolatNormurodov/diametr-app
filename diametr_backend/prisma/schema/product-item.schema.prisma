model ProductItem {
    id          Int           @id @default(autoincrement())
    // Bilingual variant names + descriptions. The old single `name` column is
    // kept so historic rows still render; new rows fill name_uz/name_ru and the
    // frontend prefers the locale match with a fallback chain.
    name    String?
    name_uz String?
    name_ru String?
    // Text (not VARCHAR(191)) so long Russian descriptions fit — the default
    // limit ran out on a 200-char cyrillic string and the dashboard showed a
    // generic 500.
    desc    String? @db.Text
    desc_ru String? @db.Text
    image       String?

    // Variant details
    unit_type_id Int?
    unit_type    UnitType? @relation(fields: [unit_type_id], references: [id])
    value        Decimal?  @db.Decimal(10, 3) // e.g. 1.5 (litres), 2.5 (kg)
    color        String?   // e.g. "Qizil", "#FF0000"
    size         String?   // e.g. "120x80", "XL"

    product_id Int?
    product    Product? @relation(fields: [product_id], references: [id])

    work_status WORK_STATUS   @default(WORKING)
    
    shop_products ShopProduct[]
    createdt  DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("productitem")
}
