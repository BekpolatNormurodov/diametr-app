model Category {
  id      Int     @default(autoincrement()) @id
  name    String?
  name_uz String?
  name_ru String?

  // Text + Russian sibling — same rationale as Product/ProductItem.
  desc     String? @db.Text
  desc_ru  String? @db.Text
  image  String?
  work_status     WORK_STATUS @default(WORKING)

  products Product[]

  createdt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("category")

}